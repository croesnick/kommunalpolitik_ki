                  "startLine": 99,
                  "snippet": {
                    "text": "        dirs = Enum.uniq([Path.dirname(declared) | dirs])"
                  }
                }
              },
              "logicalLocations": [
                {
                  "name": "Seatbelt.MachODeps.dep_dirs/6",
                  "fullyQualifiedName": "Seatbelt.MachODeps.dep_dirs/6"
                }

                    "text": "else: {:redact, \"Labels der Notiz ausserhalb von Γ\", [\"label_not_in_gamma\"]}"
                  }
                }
              },
              "logicalLocations": [
                {
                  "name": "KomkiMediator.ConnectorGate.labels/4",
                  "fullyQualifiedName": "KomkiMediator.ConnectorGate.labels/4"
                }

; Vermittler-Profil (komki-mediator, Tickets #137/#146): kein Netz-Outbound,
; nur die Connector-Sockets. Feste Eingaben -> byte-identischer Text.
(version 1)
(deny default)
; Erlang-Runtime: escript -> erl (sh) -> erlexec -> beam.smp -> erl_child_setup
(allow process-fork)
(allow process-exec (subpath "/opt/erl"))
(allow file-read* (subpath "/opt/erl"))
; erl ist ein sh-Skript (dirname/basename); /bin/sh ist ein Variantenwaehler,
; der /private/var/select/sh liest und /bin/bash startet
(allow process-exec (literal "/bin/sh") (literal "/bin/bash") (literal "/usr/bin/dirname") (literal "/usr/bin/basename"))
(allow file-read* (literal "/bin/sh") (literal "/bin/bash") (literal "/usr/bin/dirname") (literal "/usr/bin/basename"))
(allow file-read-metadata (literal "/private/var/select"))
(allow file-read* (literal "/private/var/select/sh"))
; das Escript selbst (Zip-Archiv mit Shebang; nur lesen)
(allow file-read* (literal "/opt/komki/bin/komki-mediator"))
; Boot-Schicht (macOS 27.2: ohne sie SIGABRT rc=134 beim exec)
(allow file-read* (subpath "/System/Library"))
(allow file-read* (subpath "/usr/lib"))
(allow file-read* (subpath "/System/Volumes/Preboot"))
(allow file-read* (literal "/dev/null") (literal "/dev/random") (literal "/dev/urandom"))
(allow file-write* (literal "/dev/null"))
(allow sysctl-read (sysctl-name "security.mac.lockdown_mode_state"))
(allow file-read-metadata (literal "/System/Cryptexes/Rosetta"))
(allow file-read-metadata (literal "/System/Cryptexes/App"))
(allow file-read-metadata (literal "/System/Cryptexes/OS"))
(allow file-read-metadata (literal "/System/Volumes/Data"))
(allow file-read-metadata (literal "/var"))
(allow file-read-data (literal "/"))
(allow file-read* file-test-existence file-write-data file-ioctl (literal "/dev/dtracehelper"))
(allow system-info (info-type "vfs.disk-space"))
; BEAM-Initialisierung: CPU-/OS-Sonden, Benutzerauflösung, Zeitzone, Protokolle
(allow sysctl-read (sysctl-name "kern.bootargs"))
(allow sysctl-read (sysctl-name "kern.hostname"))
(allow sysctl-read (sysctl-name "kern.iossupportversion"))
(allow sysctl-read (sysctl-name "kern.ngroups"))
(allow sysctl-read (sysctl-name "kern.osproductversion"))
(allow sysctl-read (sysctl-name "kern.osrelease"))
(allow sysctl-read (sysctl-name "kern.ostype"))
(allow sysctl-read (sysctl-name "kern.osvariant_status"))
(allow sysctl-read (sysctl-name "kern.version"))
(allow sysctl-read (sysctl-name-prefix "hw."))
(allow sysctl-read (sysctl-name-prefix "machdep.cpu."))
(allow file-read-metadata (literal "/etc"))
(allow mach-lookup (global-name "com.apple.system.opendirectoryd.libinfo"))
(allow mach-lookup (global-name "com.apple.system.notification_center"))
(allow ipc-posix-shm-read-data (ipc-posix-name "apple.shm.notification_center"))
(allow file-read* (literal "/private/etc/localtime"))
(allow file-read* (subpath "/private/var/db/timezone"))
(allow file-read* (literal "/private/etc/protocols"))
; erl_child_setup schliesst geerbte Deskriptoren ueber /dev/fd
(allow file-read-data (literal "/dev/fd"))
(allow file-read-data (literal "/dev/autofs_nowait"))
; Log (stderr-Redirect; Write-Scope genau diese Datei)
(allow file-read* file-write* (literal "/opt/komki-golden/tmp/mediator.log"))
; Raum lesen (registry.json, room.json, documents)
(allow file-read* (subpath "/opt/komki-golden/mediator"))
; Journal: anhaengen und uappnd setzen (Ticket #139)
(allow file-write* (subpath "/opt/komki-golden/mediator/journal"))
(allow process-exec (literal "/usr/bin/chflags"))
(allow file-read* (literal "/usr/bin/chflags"))
; Erstprovisionierung beim ersten Start (Templates.provision!/1)
(allow file-write* (literal "/opt/komki-golden/mediator") (literal "/opt/komki-golden/mediator/registry.json") (literal "/opt/komki-golden/mediator/room.json"))
(allow file-write* (subpath "/opt/komki-golden/mediator/documents"))
; GO-Anfragen und Offenlegungsstand (Ticket #98)
(allow file-write* (subpath "/opt/komki-golden/mediator/go"))
; Kanal pi -> Vermittler: Unix-Socket (CONTRACT.md §8), Token nur lesen
; eigener Unix-Socket (binden, 0600 setzen, alten Socket entfernen)
(allow network-bind (local unix-socket (path-literal "/opt/komki-golden/run/mediator.sock")))
(allow file-read* file-write* (literal "/opt/komki-golden/run/mediator.sock"))
(allow network-inbound (local unix-socket (path-literal "/opt/komki-golden/run/mediator.sock")))
(allow file-read* (literal "/opt/komki-golden/run/mediator.token"))
; Connector-Sockets (Frame-Protokoll, CONTRACT.md §3) — einziges Outbound
(allow network-outbound (remote unix-socket (path-literal "/opt/komki-golden/run/connectors/ris.sock")))
(allow network-outbound (remote unix-socket (path-literal "/opt/komki-golden/run/connectors/vault.sock")))
(allow network-outbound (remote unix-socket (path-literal "/opt/komki-golden/run/connectors/web.sock")))
(allow file-read-metadata (literal "/"))
(allow file-read-metadata (literal "/opt"))
(allow file-read-metadata (literal "/opt/erl"))
(allow file-read-metadata (literal "/opt/komki"))
(allow file-read-metadata (literal "/opt/komki-golden"))
(allow file-read-metadata (literal "/opt/komki-golden/mediator"))
(allow file-read-metadata (literal "/opt/komki-golden/run"))
(allow file-read-metadata (literal "/opt/komki-golden/run/mediator.sock"))
(allow file-read-metadata (literal "/opt/komki-golden/run/mediator.token"))
(allow file-read-metadata (literal "/opt/komki-golden/tmp"))
(allow file-read-metadata (literal "/opt/komki-golden/tmp/mediator.log"))
(allow file-read-metadata (literal "/opt/komki/bin"))
(allow file-read-metadata (literal "/opt/komki/bin/komki-mediator"))
; Bewusst NICHT erlaubt: Netz-Auswaerts ausser den Connector-Sockets, process-exec
; ausser Runtime und chflags, Schreiben ausserhalb von Journal, Provisionierung und Log.

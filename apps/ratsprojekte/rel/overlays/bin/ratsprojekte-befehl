#!/bin/sh
# The `ratsprojekte` command (#440): make ratsprojekte links it into the
# PATH. Arguments reach Ratsprojekte.CLI as data (System.argv/0), never as code.
set -e
self=$(readlink -f "$0")
root=$(cd "$(dirname "$self")/.." && pwd)
exec "$root/bin/ratsprojekte" eval "Ratsprojekte.CLI.main(System.argv())" "$@"

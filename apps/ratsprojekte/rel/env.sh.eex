#!/bin/sh
# Environment of the ratsprojekte release (#440, ADR 0004).

# No Erlang distribution: no port, no cookie to steal. The `ratsprojekte`
# command talks to the hub over its own Unix socket instead.
export RELEASE_DISTRIBUTION=none

# No crash dump: it would hold the hub's memory, the database key included.
export ERL_CRASH_DUMP_BYTES=0

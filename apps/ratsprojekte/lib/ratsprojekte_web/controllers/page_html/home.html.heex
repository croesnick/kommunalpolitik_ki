<Layouts.flash_group flash={@flash} />
<div class="px-4 py-10 sm:px-6 sm:py-28 lg:px-8 xl:px-28">
  <div class="mx-auto max-w-xl lg:mx-0">
    <div class="flex justify-between items-center">
      <h1 class="flex items-center text-sm font-semibold leading-6">
        Ratsprojekte · Hub
        <small class="badge badge-warning badge-sm ml-3">
          Phoenix v{Application.spec(:phoenix, :vsn)}
        </small>
      </h1>
      <Layouts.theme_toggle />
    </div>

    <p class="text-[2rem] mt-4 font-semibold leading-10 tracking-tighter text-balance">
      Der Hub ist im Aufbau.
    </p>
    <p class="mt-4 leading-7 text-base-content/70">
      ratsprojekte wird der lokale Hub für den Weg von der Idee zum Antrag
      (ADR&nbsp;0004). Dieses Gerüst läuft auf dem aktuellen Phoenix-Stand
      mit LiveView, Tailwind&nbsp;v4 und esbuild. Schema und Oberfläche
      entstehen in den Folge-Tickets.
    </p>
  </div>
</div>
